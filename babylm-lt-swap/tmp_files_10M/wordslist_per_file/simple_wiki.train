s": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 9, "context": "storing a product for one month at 35 C simulates three months at 20 C", "context_len": 15}}}, "denature": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 34, "context": "The reactions needed to feed and reproduce bacteria and fungi increase at higher temperatures , up to the point that the proteins and other compounds in their cells themselves begin to breakdown , or denature , so quickly that they can not be replaced", "context_len": 44}}}, "springy": {"freq": 1, "POS": {"VERB": {"freq": 1, "word_index": 15, "context": "Therefore , to make explosives stable for longer periods , or to keep rubber bands springy , or to force bacteria to slow down their growth , they can be cooled", "context_len": 31}}}, "cooled": {"freq": 8, "POS": {"VERB_Past": {"freq": 7, "word_index": 30, "context": "Therefore , to make explosives stable for longer periods , or to keep rubber bands springy , or to force bacteria to slow down their growth , they can be cooled", "context_len": 31}, "NOUN": {"freq": 1, "word_index": 17, "context": "It is also used to demonstrate how some things change color when heated and change back when cooled", "context_len": 18}}}, "insulated": {"freq": 1, "POS": {"VERB_Past": {"freq": 1, "word_index": 16, "context": "This is the reason shelf life is generally extended by temperature control : ( refrigeration , insulated shipping containers , controlled cold chain , etc", "context_len": 25}}}, "wrappers": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 11, "context": "`` Best before '' is sometimes put on food and drink wrappers , followed by a date", "context_len": 17}}}, "unwittingly": {"freq": 1, "POS": {"VERB": {"freq": 1, "word_index": 33, "context": "The term `` best before '' is also used to show the date by which the item will have outlived its shelf life , and is intended to ensure that customers will not unwittingly purchase or eat stale food", "context_len": 39}}}, "impractical": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 11, "context": "Sometimes the packaging process involves using pre-printed labels , making it impractical to write the `` best before '' date in a clearly visible location", "context_len": 25}}}, "supersede": {"freq": 2, "POS": {"VERB": {"freq": 2, "word_index": 10, "context": "A first bill to amend the statutory limitations period and supersede the `` Ledbetter '' decision was introduced in the 110th United States Congress but was never enacted , as after having been passed by the House it failed to survive a cloture vote in the Senate due to the opposition of most of the Republican Senators", "context_len": 57}}}, "shelving": {"freq": 1, "POS": {"VERB_PresC": {"freq": 1, "word_index": 17, "context": "Most stores will rotate stock by moving the products with the earliest dates to the front of shelving units , which allows them to be sold first and saving them from having to be either marked down or thrown away , both of which contribute to a loss of profit", "context_len": 50}}}, "reductions": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 22, "context": "It is also common for food approaching the use by date to be reduced in price for quick sale , with greater reductions the closer to the use by date it gets", "context_len": 32}}}, "metaphorical": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 2, "context": "In a metaphorical sense , much software also has a shelf life", "context_len": 12}}}, "vulnerabilities": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 11, "context": "Most software products are released to market with defects , security vulnerabilities , and design flaws", "context_len": 16}}}, "spotty": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 10, "context": "Since correct inclusion of patches at end user sites is spotty , the actual population of that software application in the field is quite varied ; some will have patches 1 and 2 , others 1 , 2 , and 3 , some others none , in all possible variations", "context_len": 50}}}, "nutrient": {"freq": 2, "POS": {"NOUN": {"freq": 2, "word_index": 11, "context": "That 's because formula must contain a certain quantity of each nutrient that is described on the label", "context_len": 18}}}, "nipple": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 11, "context": "It also separates or form lumps that will clog the bottle nipple", "context_len": 12}}}, "packed": {"freq": 2, "POS": {"VERB_Past": {"freq": 2, "word_index": 17, "context": ", which controls fresh produce and meats , only requires labeling of the date when poultry is packed at the farm", "context_len": 21}}}, "bottled": {"freq": 3, "POS": {"VERB_Past": {"freq": 3, "word_index": 22, "context": "A `` freshness date '' is the date used in the American brewing industry to indicate either the date the beer was bottled or the date before which the beer should be consumed", "context_len": 33}}}, "brewers": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 2, "context": "Many other brewers started adding freshness dates to their products , but there is no standard for what the date means", "context_len": 21}}}, "divas": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 21, "context": "The World Wrestling Entertainment ( WWE ) Women 's Championship was an official championship in World Wrestling Entertainment fought for by divas", "context_len": 22}}}, "handicap": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 13, "context": "The final champion was Layla El who defeated Beth Phoenix in a two-on-one handicap match with Michelle McCool on Smackdown and McCool self-proclaimed herself as the co-Women 's Champion", "context_len": 29}}}, "layouts": {"freq": 4, "POS": {"NOUN_P": {"freq": 3, "word_index": 37, "context": "The race led to a bigger focus on safety in Formula One as well as the reforming of the Grand Prix Drivers ' Association after 12 years of not running , and the changing of many track lay