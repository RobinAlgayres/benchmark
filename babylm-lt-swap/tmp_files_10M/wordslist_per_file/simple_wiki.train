 2, "POS": {"UNK": {"freq": 2, "word_index": 17, "context": "Although easily deformed , droplets of water tend to be pulled into a spherical shape by the cohesive forces of the surface layer", "context_len": 23}}}, "minimizes": {"freq": 1, "POS": {"VERB_PresT": {"freq": 1, "word_index": 3, "context": "The spherical shape minimizes the necessary `` wall tension '' of the surface layer according to Laplace 's law", "context_len": 19}}}, "minimization": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 6, "context": "As a result of surface area minimization , a surface will assume the smoothest shape it can", "context_len": 17}}}, "smoothest": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 13, "context": "As a result of surface area minimization , a surface will assume the smoothest shape it can", "context_len": 17}}}, "weakly": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 2, "context": "Water adheres weakly to wax and strongly to itself , so water clusters into drops", "context_len": 15}}}, "adhering": {"freq": 1, "POS": {"VERB_PresC": {"freq": 1, "word_index": 4, "context": "The animation shows water adhering to the faucet gaining mass until it is stretched to a point where the surface tension can no longer bind it to the faucet", "context_len": 29}}}, "faucet": {"freq": 5, "POS": {"NOUN": {"freq": 5, "word_index": 9, "context": "If a stream of water were running from the faucet , the stream would break up into drops during its fall", "context_len": 21}}}, "bind": {"freq": 4, "POS": {"VERB": {"freq": 4, "word_index": 24, "context": "The animation shows water adhering to the faucet gaining mass until it is stretched to a point where the surface tension can no longer bind it to the faucet", "context_len": 29}}}, "pinches": {"freq": 1, "POS": {"VERB_PresT": {"freq": 1, "word_index": 8, "context": "Gravity stretches the stream , then surface tension pinches it into spheres", "context_len": 12}}}, "spheres": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 15, "context": "The words are about man \u2019 s desire to join the heavenly music of the spheres", "context_len": 16}}}, "elastic": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 8, "context": "The surface of the water behaves like an elastic film : the insect 's feet cause indentations in the water 's surface , increasing its surface area", "context_len": 27}}}, "dissimilar": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 24, "context": "Separation of oil and water ( in this case , water and liquid wax ) is caused by a tension in the surface between dissimilar liquids", "context_len": 26}}}, "rivulets": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 9, "context": "Tears of wine is the formation of drops and rivulets on the side of a glass containing an alcoholic beverage", "context_len": 20}}}, "evaporating": {"freq": 1, "POS": {"VERB_PresC": {"freq": 1, "word_index": 17, "context": "It is induced by a combination of surface tension modification of water by ethanol together with ethanol evaporating faster than water", "context_len": 21}}}, "surfactants": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 11, "context": "Surface tension is visible in other common phenomena , especially when surfactants are used to decrease it :", "context_len": 18}}}, "taut": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 18, "context": "One way to picture this is to imagine a flat soap film bounded on one side by a taut thread of length , `` L ''", "context_len": 26}}}, "dyne": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 12, "context": "Its SI unit is newton per meter but the cgs unit of dyne per cm is also used", "context_len": 18}}}, "ergs": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 21, "context": "Consequently surface tension can be also measured in SI system as joules per square meter and in the cgs system as ergs per cm2", "context_len": 24}}}, "tensioned": {"freq": 2, "POS": {"UNK": {"freq": 1, "word_index": 7, "context": "If no force acts normal to a tensioned surface , the surface must remain flat", "context_len": 15}, "VERB_Past": {"freq": 1, "word_index": 5, "context": "The eight suspension cables are tensioned to pull with a force of 2,000 tons against the piers set into each bank", "context_len": 21}}}, "normalization": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 24, "context": "The quantity in parentheses on the right hand side is in fact ( twice ) the mean curvature of the surface ( depending on normalization )", "context_len": 26}}}, "menisci": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 13, "context": "Solutions to this equation determine the shape of water drops , puddles , menisci , soap bubbles , and all other shapes determined by surface tension", "context_len": 26}}}, "strider": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 12, "context": "( Another example is the shape of the impressions that a water strider 's feet make on the surface of a pond )", "context_len": 23}}}, "meaningless": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 11, "context": "( In the limit of a single molecule the concept becomes meaningless", "context_len": 12}}}, "fashioning": {"freq": 1, "POS": {"VERB_PresC": {"freq": 1, "word_index": 2, "context": "Yet by fashioning the frame out of wire and dipping it in soap-solution , a locally minimal surface will appear in the resulting soap-film within seconds", "context_len": 26}}}, "inferred": {"freq": 1, "POS": {"VERB_Past": {"freq": 1, "word_index": 26, "context": "This means that although the difference between the liquid-solid and solid-air surface tension , formula 20 , is difficult to measure directly , it can be inferred from the liquid-air surface tension , formula 17 , and the equilibrium contact angle , formula 5 , which is a function of the easily measurable advancing and receding contact angles ( see main article contact angle )", "context_len": 65}}}, "measurable": {"freq": 2, "POS": {"UNK": {"