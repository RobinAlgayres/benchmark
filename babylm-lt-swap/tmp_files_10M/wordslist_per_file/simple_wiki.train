OUN_P": {"freq": 1, "word_index": 3, "context": "His fellow disk jockeys voted him the nation 's best in the 1948 and 1949 `` Billboard '' polls", "context_len": 19}}}, "jollity": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 14, "context": "Shepard wrote , `` He does not crash into the home with the false jollity and thunderous witticisms of a backslapper", "context_len": 21}}}, "thunderous": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 16, "context": "Shepard wrote , `` He does not crash into the home with the false jollity and thunderous witticisms of a backslapper", "context_len": 21}}}, "witticisms": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 17, "context": "Shepard wrote , `` He does not crash into the home with the false jollity and thunderous witticisms of a backslapper", "context_len": 21}}}, "backslapper": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 20, "context": "Shepard wrote , `` He does not crash into the home with the false jollity and thunderous witticisms of a backslapper", "context_len": 21}}}, "obtrusively": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 10, "context": "He is pleasant , serious , scholarly looking and not obtrusively convivial", "context_len": 12}}}, "convivial": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 11, "context": "He is pleasant , serious , scholarly looking and not obtrusively convivial", "context_len": 12}}}, "upraised": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 17, "context": "`` On television , Garroway was known for his signoff , saying `` Peace '' with an upraised palm", "context_len": 19}}}, "impromptu": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 14, "context": "Garroway , Studs Terkel , and Hugh Downs all hosted relaxed , talkative , impromptu shows in that city in the early 1950s", "context_len": 23}}}, "authoritative": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 8, "context": "Earlier radio and television voices spoke with an authoritative `` announcer 's '' intonation , resembling public oration , often dropping about a musical fifth on the last word of a sentence", "context_len": 32}}}, "intonation": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 13, "context": "Earlier radio and television voices spoke with an authoritative `` announcer 's '' intonation , resembling public oration , often dropping about a musical fifth on the last word of a sentence", "context_len": 32}}}, "oration": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 17, "context": "Earlier radio and television voices spoke with an authoritative `` announcer 's '' intonation , resembling public oration , often dropping about a musical fifth on the last word of a sentence", "context_len": 32}}}, "conversational": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 8, "context": "Garroway was one of the broadcasters who introduced conversational style and tone to television , beginning some broadcasts as though the viewer were sitting in the studio with him , as in this November 20 , 1957 , introduction for the `` Today '' show : `` And how are you about the world today ? Let 's see what kind of shape it 's in ; there is a glimmer of hope", "context_len": 73}}}, "glimmer": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 70, "context": "Garroway was one of the broadcasters who introduced conversational style and tone to television , beginning some broadcasts as though the viewer were sitting in the studio with him , as in this November 20 , 1957 , introduction for the `` Today '' show : `` And how are you about the world today ? Let 's see what kind of shape it 's in ; there is a glimmer of hope", "context_len": 73}}}, "airwaves": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 23, "context": "Garroway soon was joined by news editor Jim Fleming and announcer Jack Lescoulie as television 's first loose `` family '' of the airwaves when the show debuted on Monday , January 14 , 1952", "context_len": 35}}}, "panned": {"freq": 1, "POS": {"VERB_Past": {"freq": 1, "word_index": 2, "context": "Though initially panned by critics , Garroway 's style attracted a large audience that enjoyed his easygoing presence early in the morning", "context_len": 22}}}, "puckish": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 10, "context": "His familiar `` cohost , '' a chimpanzee with the puckish name of J", "context_len": 14}}}, "seriousness": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 13, "context": "Fred Muggs , did n't hurt his genial manner , but his concurrent seriousness in dealing with news stories and ability to clearly explain abstract concepts earned him the nickname `` The Communicator '' and eventually won praise from critics and viewers alike", "context_len": 43}}}, "expos": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 24, "context": "Garroway took `` Today '' to various locations as its host : Paris in 1959 and Rome in 1960 ; car shows and technology expos ; plays and movies ; and aboard an Air Force B-52 for a practice bombing run", "context_len": 41}}}, "crusades": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 21, "context": "In late 1960 , Garroway hosted a special filmed program for the Billy Graham Evangelistic Association that traced Billy Graham 's crusades from 1949 to 1960", "context_len": 26}}}, "afternoons": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 31, "context": "Later he went back to working in radio , doing `` split shift '' shows called `` Garroway AM '' ( mid mornings ) and `` Garroway PM '' ( mid afternoons ) for WCBS ( AM ) , New York", "context_len": 41}}}, "sporadically": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 2, "context": "Garroway appeared sporadically on other television programs without achieving anywhere near the success and recognition levels he enjoyed on `` Today ''", "context_len": 22}}}, "reemerged": {"freq": 1, "POS": {"VERB_Past": {"freq": 1, "word_index": 17, "context": "The most viewers saw of him for the rest of the 1960s and 1970s was whenever he reemerged for `` Today '' anniversaries", "context_len": 23}}}, "anniversaries": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 22, "context": "The most viewers saw of him for the rest of the 1960s and 1970s was whenever he reemerged for `` Today '' anniversaries", "context_len": 23}}}, "pitchman": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 12, "context": "In his role as `` Today '' host , Garroway acted as pitchman for several of the show 's sponsors", "context_len": 20}}}, "inveterate": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 6, "context": "Garroway , an amateur drummer and inveterate music lover , lent his name to a series of recordings of jazz , classical , and pop music released in the late 1950s and early 1960s", "context_len": 34}}}, "clippings": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 21, "context": "The book never made it past the research stage ; the surviving notes , manuscripts , audio tapes , and news clippings were sent to former `` Today '' researcher Lee Lawrence", "context_len": 32}}}, "resided": {"freq": 2, "POS": {"VERB_Past": {"freq": 2, "word_index": 29, "context": "Upon Lawrence 's death in 2003 , the boxes were turned over to the Library of American Broadcasting , Special Collections , University of Maryland Libraries , where they resided as of 2009", "context_len": 33}}}, "spoofed": {"freq": 1, "POS": {"VERB_Past": {"freq": 1, "word_index": 3, "context": "`` Mad '' spoofed him in one issue as `` Dave Garrowunway", "context_len": 12}}}, "automaker": {"freq": 2, "POS": {"NOUN": {"freq": 2, "word_index": 11, "context": "As of 2011 , it is the world 's fastest growing automaker for two years in a row", "context_len": 18}}}, "carp": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 22, "context": "The frog is a millimeter smaller than the previous record holder for being the world 's smallest vertebrate \u2013