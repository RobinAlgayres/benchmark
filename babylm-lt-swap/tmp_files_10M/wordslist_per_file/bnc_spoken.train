": {"freq": 2, "word_index": 46, "context": "A thought er went , slipped by me er we must upon this council thank the committee staff that controlled the multitude outside , er they were n't trained for it but can the er thanks of this council for their endeavours in keeping the situation calm be recorded", "context_len": 49}}}, "curing": {"freq": 8, "POS": {"NOUN": {"freq": 5, "word_index": 8, "context": "The the horse-drawn lorries going to the different curing stations where the gutter girls stood at the far end dressed in their oilskin aprons ready to start the day 's work", "context_len": 31}, "VERB_PresC": {"freq": 3, "word_index": 10, "context": "And I 'll tell you what they what they each curing station used to have what they call foy before they went away", "context_len": 23}}}, "gutter": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 12, "context": "The the horse-drawn lorries going to the different curing stations where the gutter girls stood at the far end dressed in their oilskin aprons ready to start the day 's work", "context_len": 31}}}, "oilskin": {"freq": 3, "POS": {"UNK": {"freq": 3, "word_index": 22, "context": "The the horse-drawn lorries going to the different curing stations where the gutter girls stood at the far end dressed in their oilskin aprons ready to start the day 's work", "context_len": 31}}}, "aprons": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 23, "context": "The the horse-drawn lorries going to the different curing stations where the gutter girls stood at the far end dressed in their oilskin aprons ready to start the day 's work", "context_len": 31}}}, "grumblers": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 1, "context": "No grumblers there believe me and to walk past them would be to hear them singing while you work", "context_len": 19}}}, "gutting": {"freq": 2, "POS": {"NOUN": {"freq": 1, "word_index": 1, "context": "Their gutting knives flashing in time to the music", "context_len": 9}, "VERB_PresC": {"freq": 1, "word_index": 10, "context": "I can remember at least six of the Stronsay women gutting the herring at that time and they stood on Moars beach", "context_len": 22}}}, "thrill": {"freq": 2, "POS": {"NOUN": {"freq": 1, "word_index": 20, "context": "When I was about ten years old , a trip to the village from the South end was a bigger thrill than a trip to a big city would be to a present day child , later working in the village as a teenager , the dances every Saturday and Monday night was enjoyment never to be forgot", "context_len": 58}, "UNK": {"freq": 1, "word_index": 15, "context": "No wild animals , just ponies , monkeys and dogs , but it was great thrill seeing a girl in green tights and a frilly skirt , standing on a pony 's back while it galloped round the ring", "context_len": 39}}}, "teenager": {"freq": 2, "POS": {"NOUN": {"freq": 2, "word_index": 43, "context": "When I was about ten years old , a trip to the village from the South end was a bigger thrill than a trip to a big city would be to a present day child , later working in the village as a teenager , the dances every Saturday and Monday night was enjoyment never to be forgot", "context_len": 58}}}, "cottage": {"freq": 18, "POS": {"NOUN": {"freq": 18, "word_index": 29, "context": "I could become a burden to me wife and family , not only that , if I could n't pay the mortgage they might throw us out of the cottage", "context_len": 30}}}, "amplifiers": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 1, "context": "No amplifiers in those days , but the old cinema rang from end to end with everyone in festive mood", "context_len": 20}}}, "festive": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 18, "context": "No amplifiers in those days , but the old cinema rang from end to end with everyone in festive mood", "context_len": 20}}}, "brisk": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 11, "context": "There were three ice cream shops and a chip shop doing brisk trade all the time", "context_len": 16}}}, "oldies": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 3, "context": "Most of us oldies remember Mr , going his rounds with his ice cream barrel , proclaiming his wares to be the best in the world and no Summer was complete without him", "context_len": 33}}}, "proclaiming": {"freq": 2, "POS": {"VERB_PresC": {"freq": 2, "word_index": 37, "context": "That 's a fairly tenuous er sort of platform to get rid of those er hunting jobs and I'd 've thought that er , a party whose leader Mr saw him , was it yesterday ? , proclaiming the importance of er protecting employment and combating unemployment", "context_len": 47}}}, "wares": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 18, "context": "Most of us oldies remember Mr , going his rounds with his ice cream barrel , proclaiming his wares to be the best in the world and no Summer was complete without him", "context_len": 33}}}, "hut": {"freq": 6, "POS": {"NOUN": {"freq": 6, "word_index": 24, "context": "I 've been to Newark on a Friday night and stood in a line with others on a night shift at a w wooden hut in the yard whilst a clerk from the pay office came to meet us , the day shift finishing at er , say five o'clock", "context_len": 50}}}, "hymn": {"freq": 2, "POS": {"NOUN": {"freq": 1, "word_index": 15, "context": "On Sunday night , a visit to Sister 's rest hut to join in the hymn singing was the highlight of the week", "context_len": 23}, "UNK": {"freq": 1, "word_index": 18, "context": "It , i I had the initiative in getting a prayer book , er , er , a hymn book from the back which er , after some concentration with the index or something , to er", "context_len": 37}}}, "harmonium": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 3, "context": "With a small harmonium providing the lead it really was magnificent harmony", "context_len": 12}}}, "harmony": {"freq": 3, "POS": {"NOUN": {"freq": 3, "word_index": 34, "context": "The president , according to t