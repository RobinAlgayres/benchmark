req": 1, "POS": {"VERB_Past": {"freq": 1, "word_index": 13, "context": "Lower Manhattan or `` downtown '' is defined most commonly as the area delineated on the north by 14th Street , on the west by the Hudson River , on the east by the East River , and on the south by New York Harbor ( also known as Upper New York Bay )", "context_len": 54}}}, "environs": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 16, "context": "When referring specifically to the lower Manhattan business district such as Wall Street and its immediate environs , the northern border is commonly designated by thoroughfares approximately a mile-and-a-half ( 3 km ) south of 14th Street and a mile ( 2 km ) north of the island 's southern tip : Chambers Street from near the Hudson east to the Brooklyn Bridge entrances and overpass", "context_len": 66}}}, "thoroughfares": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 25, "context": "When referring specifically to the lower Manhattan business district such as Wall Street and its immediate environs , the northern border is commonly designated by thoroughfares approximately a mile-and-a-half ( 3 km ) south of 14th Street and a mile ( 2 km ) north of the island 's southern tip : Chambers Street from near the Hudson east to the Brooklyn Bridge entrances and overpass", "context_len": 66}}}, "screenwriters": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 33, "context": "Jules Cl\u00e9ment Naudet ( born Paris , France , April 26 , 1973 ) and Thomas G\u00e9d\u00e9on Naudet ( born Paris , France , March 27 , 1970 ) are French directors , screenwriters and producers", "context_len": 36}}}, "jules": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 0, "context": "Jules captured footage of the first plane flying into the North tower of the World Trade Center", "context_len": 17}}}, "boxers": {"freq": 5, "POS": {"NOUN_P": {"freq": 5, "word_index": 16, "context": "Their first film , `` Hope , Gloves and Redemption , '' ( 2000 ) on boxers in the Bronx , included coverage of the 1998 New York Daily News Golden Gloves tournament", "context_len": 33}}}, "withstand": {"freq": 2, "POS": {"VERB": {"freq": 2, "word_index": 5, "context": "They are usually built to withstand an impact of 3600 `` g '' and temperatures of over 1,000 C ( as required by EUROCAE ED-112 ) , because a powerful impact followed by a very hot fire is what often happens in a plane crash", "context_len": 45}}}, "sportsperson": {"freq": 5, "POS": {"NOUN": {"freq": 5, "word_index": 15, "context": "Every eligible player who is not chosen in their league 's draft is an undrafted sportsperson", "context_len": 16}}}, "ballistic": {"freq": 2, "POS": {"UNK": {"freq": 2, "word_index": 4, "context": "Due to advancements in ballistic technologies and modern warfare tactics , flamethrowers are much less common in modern theatres", "context_len": 19}}}, "warhead": {"freq": 1, "POS": {"VERB": {"freq": 1, "word_index": 8, "context": "It was able to carry a one ton warhead up to 50 miles into the air , and travel hundreds of miles to a target", "context_len": 25}}}, "pad": {"freq": 3, "POS": {"NOUN": {"freq": 2, "word_index": 24, "context": "At first , the Navy was in charge , but their first Vanguard satellite was destroyed when the rocket blew up on the launch pad in December 1957", "context_len": 28}, "VERB": {"freq": 1, "word_index": 14, "context": "While the astronauts and the crew assigned to help the astronauts from the launch pad both tried their best to get Grissom , White , and Chaffee out of the fire , they could not", "context_len": 35}}}, "humankind": {"freq": 1, "POS": {"VERB": {"freq": 1, "word_index": 8, "context": "Von Braun 's work was able to give humankind a wider view into the universe", "context_len": 15}}}, "entities": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 13, "context": "The National Football League Most Valuable Player Award is an award by different entities , most notably the Associated Press , to the player who is thought to be the most valuable player in the league", "context_len": 36}}}, "excepting": {"freq": 1, "POS": {"VERB_PresC": {"freq": 1, "word_index": 13, "context": "United Press International gave an NFL MVP Award from 1948 through 1969 , excepting 1949-50 , and 1952", "context_len": 18}}}, "clutter": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 35, "context": "To distinguish players of different nations , a flag is placed beside players born outside of Canada ; the Canadian flag ( ) will not be shown next to Canadian players in order to avoid clutter", "context_len": 36}}}, "goalies": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 14, "context": "The statistics listed include the 2006\u201307 NHL season and the 2006\u201307 NHL playoffs Active goalies ( as of September 2007 ) are listed in boldface", "context_len": 25}}}, "interceptions": {"freq": 8, "POS": {"NOUN_P": {"freq": 8, "word_index": 27, "context": "Green had another strong season in 2005 , throwing for 4,010 yards ( second only to New England 's Tom Brady ) , and throwing just 10 interceptions , his lowest season total ever", "context_len": 34}}}, "starter": {"freq": 11, "POS": {"NOUN": {"freq": 8, "word_index": 8, "context": "On August 20 the Dolphins named Green the starter with Cleo Lemon named as his backup , despite the fact that neither of them had thrown a touchdown pass to that point in pre-season play", "context_len": 35}, "UNK": {"freq": 3, "word_index": 8, "context": "The game was included in the console 's starter game package , and subsequently became the so-called `` killer application '' of the Xbox platform , selling millions of copies and bringing billions of dollars in profits", "context_len": 37}}}, "preseason": {"freq": 3, "POS": {"UNK": {"freq": 2, "word_index": 23, "context": "In 1999 , Green was slated to be the starter for the Rams , but suffered a gruesome season-ending knee injury in a preseason game on a hit by Rodney Harrison of the Chargers", "c