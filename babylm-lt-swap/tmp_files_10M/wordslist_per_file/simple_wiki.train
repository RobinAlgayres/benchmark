ntext_len": 10}, "UNK": {"freq": 1, "word_index": 18, "context": "The Supreme Court of India used practical interpretation of the Indian Constitution to protect the poorest and most oppressed groups of the population in several cases of public interest litigation", "context_len": 30}}}, "oppressors": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 8, "context": "No one would help them , because their oppressors had power on their side", "context_len": 14}}}, "commandments": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 14, "context": "The book finishes by saying : `` '' Fear God , and keep his commandments ; for that is the whole duty of everyone '' ( 12:13 )", "context_len": 28}}}, "reap": {"freq": 1, "POS": {"VERB": {"freq": 1, "word_index": 37, "context": "President Joe Biden has also made a brief reference of Ecclesiastes during his winning speech after the 2020 Presidential Election : `` To everything there is a season : a time to build , a time to reap , and a time to sow and a time to heal", "context_len": 49}}}, "sow": {"freq": 1, "POS": {"VERB": {"freq": 1, "word_index": 43, "context": "President Joe Biden has also made a brief reference of Ecclesiastes during his winning speech after the 2020 Presidential Election : `` To everything there is a season : a time to build , a time to reap , and a time to sow and a time to heal", "context_len": 49}}}, "pluck": {"freq": 2, "POS": {"VERB": {"freq": 2, "word_index": 22, "context": "`` A time to be born , and a time to die ; a time to plant , and a time to pluck up that which is planted ; '' & lt ; br & gt ;", "context_len": 37}}}, "weep": {"freq": 1, "POS": {"VERB": {"freq": 1, "word_index": 4, "context": "`` A time to weep , and a time to laugh ; a time to mourn , and a time to dance ; '' & lt ; br & gt ;", "context_len": 31}}}, "embrace": {"freq": 2, "POS": {"VERB": {"freq": 2, "word_index": 19, "context": "`` A time to cast away stones , and a time to gather stones together ; a time to embrace , and a time to refrain from embracing ; '' & lt ; br & gt ;", "context_len": 37}}}, "embracing": {"freq": 2, "POS": {"VERB_PresC": {"freq": 1, "word_index": 27, "context": "`` A time to cast away stones , and a time to gather stones together ; a time to embrace , and a time to refrain from embracing ; '' & lt ; br & gt ;", "context_len": 37}, "NOUN": {"freq": 1, "word_index": 12, "context": "The Ancient Indian work `` Kama Sutra '' mentions different types of embracing , kissing , and marking with nails and teeth", "context_len": 22}}}, "rend": {"freq": 1, "POS": {"VERB": {"freq": 1, "word_index": 4, "context": "`` A time to rend , and a time to sew ; a time to keep silence , and a time to speak ; '' & lt ; br & gt ;", "context_len": 32}}}, "sew": {"freq": 1, "POS": {"VERB": {"freq": 1, "word_index": 10, "context": "`` A time to rend , and a time to sew ; a time to keep silence , and a time to speak ; '' & lt ; br & gt ;", "context_len": 32}}}, "disciples": {"freq": 4, "POS": {"NOUN_P": {"freq": 4, "word_index": 6, "context": "After Judas died , the other disciples chose a man named Matthias to take his place as a new disciple in the group of 12", "context_len": 25}}}, "gospels": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 19, "context": "After Anastasius , it became traditional for priests to stand and bow their head as they read from the gospels", "context_len": 20}}}, "apostles": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 10, "context": "He is said to have been the treasurer for the apostles", "context_len": 11}}}, "betraying": {"freq": 1, "POS": {"VERB_PresC": {"freq": 1, "word_index": 9, "context": "Later ; due to great sense of guilt for betraying Jesus , Judas tried to give back the silver", "context_len": 19}}}, "betray": {"freq": 1, "POS": {"VERB": {"freq": 1, "word_index": 14, "context": "At the Last Supper , Jesus told his disciples that one of them would betray him", "context_len": 16}}}, "praying": {"freq": 3, "POS": {"VERB_Pr