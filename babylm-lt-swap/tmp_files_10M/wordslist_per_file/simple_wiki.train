eq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 14, "context": "As its name states , the research at the LHC involves the collision of hadrons", "context_len": 15}}}, "hadron": {"freq": 2, "POS": {"NOUN": {"freq": 2, "word_index": 1, "context": "A hadron is a particle which consists of a number of quarks held together by the subatomic strong force", "context_len": 19}}}, "quarks": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 17, "context": "This allows physicists to study the structure of the atomic nucleus , specifically the interaction of the quarks that make up protons and neutrons of the nucleus", "context_len": 27}}}, "accelerates": {"freq": 1, "POS": {"VERB_PresT": {"freq": 1, "word_index": 2, "context": "The LHC accelerates these protons through the tunnel until they reach nearly the speed of light", "context_len": 16}}}, "milliseconds": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 19, "context": "The observations researchers are able to make can help us learn what the universe might have been like within milliseconds after the big bang", "context_len": 24}}}, "bang": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 23, "context": "The observations researchers are able to make can help us learn what the universe might have been like within milliseconds after the big bang", "context_len": 24}}}, "ionizes": {"freq": 1, "POS": {"VERB_PresT": {"freq": 1, "word_index": 2, "context": "The LHC ionizes Hydrogen atoms to get their protons", "context_len": 9}}}, "ionize": {"freq": 2, "POS": {"VERB": {"freq": 2, "word_index": 2, "context": "When they ionize the atoms , they are removing the one electron to give it a net positive charge", "context_len": 19}}}, "electromagnets": {"freq": 3, "POS": {"NOUN_P": {"freq": 3, "word_index": 17, "context": "It is the alignment of electrons in the atomic shells of ferromagnets and the spinning electrons in electromagnets , that provides a material with it \u2019 s magnetism", "context_len": 28}}}, "decaying": {"freq": 3, "POS": {"VERB_PresC": {"freq": 3, "word_index": 28, "context": "The protons hit one another at close to the speed of light and this creates lots of particles , many of which only live a short time before decaying to lighter particles", "context_len": 32}}}, "collider": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 9, "context": "The lab shut down for the winter and the collider was not used again until November 2009", "context_len": 17}}}, "somethings": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 14, "context": "At the time of the warning , there is usually still time to do somethings to prevent data loss by copying the data to a different drive", "context_len": 27}}}, "predictive": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 11, "context": "Work at Google on over 100,000 drives has shown little overall predictive value of S", "context_len": 15}}}, "implementations": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 4, "context": "In turn , computer implementations are significant in applying ideas from discrete mathematics to real-world problems , such as in operations research , game theory and graph theory", "context_len": 28}}}, "probational": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 10, "context": "Also , first errors in reallocations , offline reallocations and probational counts have higher probabilities of failure", "context_len": 17}}}, "probabilities": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 14, "context": "Also , first errors in reallocations , offline reallocations and probational counts have higher probabilities of failure", "context_len": 17}}}, "vendor": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 3, "context": "Each disk drive vendor was free to decide which parameters were to be included for monitoring , and what their thresholds should be", "context_len": 23}}}, "standardization": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 9, "context": "Compaq submitted their implementation to Small Form Committee for standardization in early 1995", "context_len": 13}}}, "flexibility": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 11, "context": "The Committee chose IntelliSafe 's approach , as it provided more flexibility", "context_len": 12}}}, "threshold": {"freq": 5, "POS": {"UNK": {"freq": 1, "word_index": null, "context": null, "context_len": 0}, "NOUN": {"freq": 3, "word_index": 2, "context": "A `` threshold exceeded '' value is intended to indicate that there is a relatively high probability that the drive will not be able to honour its specification in the future \u2013 that is , the drive is `` about to fail ''", "context_len": 43}, "VERB": {"freq": 1, "word_index": 11, "context": "Each drive manufacturer defines a set of attributes , and sets threshold values beyond which attributes should not pass under normal operation", "context_len": 22}}}, "catastrophically": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 6, "context": "If a drive has already failed catastrophically , the SMART status may be inaccessible", "context_len": 14}}}, "inaccessible": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 13, "context": "If a drive has already failed catastrophically , the SMART status may be inaccessible", "context_len": 14}}}, "rotational": {"freq": 3, "POS": {"UNK": {"freq": 3, "word_index": 27, "context": "In order to prevent this problem , modern hard drives will always finish writing at least the current sector immediately after the power fails ( typically using rotational energy from the disk )", "context_len": 33}}}, "spare": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 28, "context": "Also , even if the physical disk is damaged at one location , such that a certain sector is unreadable , the disk may be able to use spare space to replace the bad area , so that the sector can be overwritten", "context_len": 43}}}, "overwritten": {"freq": 1, "POS": {"VERB": {"freq": 1, "word_index": 42, "context": "Also , even if the physical disk is damaged at one location , such that a certain sector is unreadable , the disk may be able to use spare space to replace the bad area , so that the sector can be overwritten", "context_len": 43}}}, "motherboards": {"freq": 2, "POS": {"NOUN_P": {"freq": 2, "word_index": 1, "context": "Many motherboards will display a warning message when a disk drive is approaching failure", "context_len": 14}}}, "proprietary": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 18, "context": "Although an industry standard among most major hard drive manufacturers , there are some remaining issues and much proprietary `` secret knowledge '' held by individual manufacturers as to their specific approach", "context_len": 32}}}, "reasonably": {"freq": 2, "POS": {"UNK": {"freq": 2, "word_index": 18, "context": "support even if it does not include , say , a temperature sensor , which the customer might reasonably expect to be present", "context_len": 23}}}, "subsystem": {"freq": 2, "POS": {"NOUN": {"freq": 2, "word_index": 19, "context": "Generally this is because , under normal RAID operational conditions , the computer is not permitted by the RAID subsystem to 'see ' ( or directly access ) individual physical drives , but may access only logical volumes instead", "context_len": 39}}}, "normalized": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 38, "context": "Each attribute has a `` raw value '' , whose meaning is entirely up to the drive manufacturer ( but often corresponds to counts or a physical unit , such degrees Celsius or seconds ) , and a normalized value , which ranges from 1 to 253 ( with 1 representing the worst case and 253 representing the best )", "context_len": 60}}}, "prognosis": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 0, "context": "Prognosis of this date is based on the factor `` Speed of attribute change '' ; how many points each month the value is decreasing or increasing", "context_len": 27}}}, "uncomplicated": {"freq": 1, "POS": {"VERB_Past": {"freq": 1, "word_index": 0, "context": "Uncomplicated Firewall is a firewall for host-based iptables firewall configuration", "context_len": 10}}}, "firewall": {"freq": 2, "POS": {"NOUN": {"freq": 1, "word_index": null, "context": null, "context_len": 0}, "UNK": {"freq": 1, "word_index": null, "context": null, "context_len": 0}}}, "groove": {"freq": 2, "POS": {"NOUN": {"freq": 2, "word_index": 6, "context": "There is a dolmen and a groove nearby", "context_len": 8}}}, "retroactively": {"freq": 1, "POS": {"UNK": {"freq": 1, "word_index": 14, "context": "With the market introduction of Serial ATA in 2003 , the original ATA was retroactively renamed Parallel ATA ( PATA )", "context_len": 21}}}, "downwards": {"freq": 1, "POS": {"NOUN_P": {"freq": 1, "word_index": 4, "context": "The protocol is `` downwards '' -compatible with second generation SATA drives", "context_len": 12}}}, "connectors": {"freq": 4, "POS": {"NOUN_P": {"freq": 4, "word_index": 14, "context": "The ADC , TDC and other digital electronics are typically large circuit boards with connectors at the front edge that provide input and output for digital signals , and a connector at the back that plugs into a backplane", "context_len": 39}}}, "incorrect": {"freq": 2, "POS": {"UNK": {"freq": 2, "word_index": 21, "context": "In order to boost performance , it had to decide the order of the requests based on its own , possibly incorrect , idea of what the hard drive was doing", "context_len": 31}}}, "relieve": {"freq": 2, "POS": {"VERB": {"freq": 2, "word_index": 20, "context": "With TCQ , the drive can make its own decisions about how to order the requests ( and in turn relieve the operating system from having to do so )", "context_len": 30}}}, "fulfilling": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 8, "context": "The queue is constantly receiving new requests and fulfilling and removing existing requests , and re-ordering the queue according to the current pending read write requests and the changing position of the head", "context_len": 33}}}, "reordering": {"freq": 1, "POS": {"VERB_PresC": {"freq": 1, "word_index": 2, "context": "The exact reordering algorithm may depend upon the controller and the drive itself , but the host computer simply makes requests as needed , leaving the controller to handle the details", "context_len": 31}}}, "queuing": {"freq": 1, "POS": {"NOUN": {"freq": 1, "word_index": 1, "context": "This queuing mechanism is sometimes referred to as `` elevator seeking '' , as the image of a modern elevator in a building servicing multiple calls and processing them to minimise travel illustrates the idea well", "context_len": 36}}}, "servicing": {"freq": 1, "POS": {"VERB_PresC": {"freq": 1, "word_index": 23, "context": "This queuing mechanism is sometimes referred to as `` elevator seeking '' , as the image of a modern elevator in a building servicing multiple calls and processing them to minimise travel illustrates the idea well", "context_len": 36}}}, "optimize": {"freq": 1, "POS": {"VERB": {"freq": 1, "word_index": 15, "context": "It can do this under certain situations by allowing the individual hard disk to internally optimize the order in which it executes the read and write requests it received", "context_len": 29}}}, "executes": {"freq": 1, "POS": {"VERB_PresT": {"freq": 1, "word_index": 21, "context": "It can do this under certain situations by allowing the individual hard disk to internally optimize the order in which it executes the read and write requests it received", "context_len": 29}}}, "sequential": {"freq": 3, "POS": {"UNK": {"freq": 3, "word_index": 16, "context": "However , the technology can slow down HD access in certain applications , like games and sequential reads and writes , because of the added latency induced by NCQ logic", "context_len": 30}}}, "constrained": {"freq": 1, "POS": {"VERB_Past": {"freq": 1, "word_index": 7, "context": "ATA 's attempt at integrating